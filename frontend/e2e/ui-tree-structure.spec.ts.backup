import { test, expect } from '@playwright/test'

test.describe('UI Tree Structure Builder - EnhancedAddFieldModal', () => {
  test.beforeEach(async ({ page }) => {
    // Navigate to the application (loads AdvancedTransform directly)
    await page.goto('http://localhost:3000')
    await page.waitForLoadState('domcontentloaded')
    await page.waitForTimeout(1000) // Give time for React to render
  })

  // Helper function to open the Add Field modal
  const openAddFieldModal = async (page) => {
    const addFieldButton = page.getByRole('button', { name: /^add field$/i })
    await addFieldButton.waitFor({ state: 'visible', timeout: 10000 })
    await addFieldButton.click()
    await page.waitForTimeout(300)
  }

  test('UI-1: Modal opens and displays basic fields', async ({ page }) => {
    await openAddFieldModal(page)

    // Verify modal is open
    await expect(page.getByRole('dialog')).toBeVisible()
    await expect(page.getByText(/add new field/i)).toBeVisible()

    // Verify basic fields are present
    await expect(page.getByLabel(/target field name/i)).toBeVisible()
    await expect(page.getByLabel(/field type/i)).toBeVisible()
    
    console.log('✓ Modal opens successfully with basic fields')
  })

  test('UI-2: Tree Structure Builder appears for NESTED_OBJECT type', async ({ page }) => {
    // Navigate and open modal
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    // Initially, Tree Structure Builder should not be visible
    const treeBuilderText = page.getByText(/tree structure builder/i)
    await expect(treeBuilderText).not.toBeVisible()

    // Select Field Type dropdown
    await page.getByLabel(/field type/i).click()
    
    // Select "Nested Object Field"
    await page.getByRole('option', { name: /nested object/i }).click()

    // Now Tree Structure Builder should be visible
    await expect(treeBuilderText).toBeVisible()
    
    // Verify tree icon and parent node selector
    await expect(page.getByLabel(/parent node/i)).toBeVisible()

    console.log('✓ Tree Structure Builder appears for NESTED_OBJECT type')
  })

  test('UI-3: Create root level field (L1)', async ({ page }) => {
    // Navigate and open modal
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    // Fill in field details
    await page.getByLabel(/target field name/i).fill('Organization')
    
    // Select NESTED_OBJECT type
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()

    // Fill source field
    await page.getByLabel(/source field name/i).fill('organization')

    // Verify nesting level is 1 (or auto-set)
    const nestingLevelInput = page.getByLabel(/nesting level/i)
    const levelValue = await nestingLevelInput.inputValue()
    expect(parseInt(levelValue)).toBeGreaterThanOrEqual(1)

    // Click Add Field
    await page.getByRole('button', { name: /^add field$/i }).click()

    // Verify modal closes
    await expect(page.getByRole('dialog')).not.toBeVisible()

    // Verify success message
    await expect(page.getByText(/added field.*organization/i)).toBeVisible()

    console.log('✓ Root level field (Organization L1) created successfully')
  })

  test('UI-4: Create nested field under parent with auto-calculation', async ({ page }) => {
    // Navigate and open modal
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    // First, create root field "Organization"
    let addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/target field name/i).fill('Organization')
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()
    await page.getByLabel(/source field name/i).fill('organization')
    await page.getByRole('button', { name: /^add field$/i }).click()

    // Wait for modal to close
    await page.waitForTimeout(500)

    // Now add child field "Departments"
    addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/target field name/i).fill('Departments')
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()

    // Open parent node dropdown
    await page.getByLabel(/parent node/i).click()

    // Select "Organization (L1)"
    const organizationOption = page.getByRole('option', { name: /organization.*l1/i })
    await expect(organizationOption).toBeVisible()
    await organizationOption.click()

    // Verify nesting level auto-calculated to 2
    const nestingLevelInput = page.getByLabel(/nesting level/i)
    const levelValue = await nestingLevelInput.inputValue()
    expect(parseInt(levelValue)).toBe(2)

    // Verify status message
    await expect(page.getByText(/field will be nested under.*organization/i)).toBeVisible()

    // Fill source field
    await page.getByLabel(/source field name/i).fill('departments')

    // Add field
    await page.getByRole('button', { name: /^add field$/i }).click()

    // Verify success
    await expect(page.getByText(/added field.*departments/i)).toBeVisible()

    console.log('✓ Nested field with auto-calculated level created successfully')
  })

  test('UI-5: Build complex 4-level hierarchy', async ({ page }) => {
    // Navigate
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    // Helper function to add field
    const addField = async (fieldName: string, sourceField: string, parentName?: string) => {
      const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
      await addFieldButton.click()

      await page.getByLabel(/target field name/i).fill(fieldName)
      await page.getByLabel(/field type/i).click()
      await page.getByRole('option', { name: /nested object/i }).click()

      if (parentName) {
        await page.getByLabel(/parent node/i).click()
        await page.getByRole('option', { name: new RegExp(parentName, 'i') }).click()
      }

      await page.getByLabel(/source field name/i).fill(sourceField)
      await page.getByRole('button', { name: /^add field$/i }).click()
      await page.waitForTimeout(300)
    }

    // Level 1: Organization
    await addField('Organization', 'organization')

    // Level 2: Departments under Organization
    await addField('Departments', 'departments', 'Organization')

    // Level 3: Teams under Departments
    await addField('Teams', 'teams', 'Departments')

    // Level 4: Employees under Teams
    await addField('Employees', 'employees', 'Teams')

    // Verify all fields created
    await expect(page.getByText(/added field.*employees/i)).toBeVisible()

    console.log('✓ Complex 4-level hierarchy created successfully')
    console.log('  Organization (L1) → Departments (L2) → Teams (L3) → Employees (L4)')
  })

  test('UI-6: Parent dropdown shows hierarchical tree structure', async ({ page }) => {
    // Navigate
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    // Create 3-level hierarchy first
    const addField = async (fieldName: string, sourceField: string, parentName?: string) => {
      const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
      await addFieldButton.click()
      await page.getByLabel(/target field name/i).fill(fieldName)
      await page.getByLabel(/field type/i).click()
      await page.getByRole('option', { name: /nested object/i }).click()
      if (parentName) {
        await page.getByLabel(/parent node/i).click()
        await page.getByRole('option', { name: new RegExp(parentName, 'i') }).click()
      }
      await page.getByLabel(/source field name/i).fill(sourceField)
      await page.getByRole('button', { name: /^add field$/i }).click()
      await page.waitForTimeout(300)
    }

    await addField('Company', 'company')
    await addField('Divisions', 'divisions', 'Company')
    await addField('Departments', 'departments', 'Divisions')

    // Now open modal and check dropdown
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()

    // Open parent dropdown
    await page.getByLabel(/parent node/i).click()

    // Verify all levels are visible in dropdown
    await expect(page.getByRole('option', { name: /none.*root level/i })).toBeVisible()
    await expect(page.getByRole('option', { name: /company.*l1/i })).toBeVisible()
    await expect(page.getByRole('option', { name: /divisions.*l2/i })).toBeVisible()
    await expect(page.getByRole('option', { name: /departments.*l3/i })).toBeVisible()

    console.log('✓ Parent dropdown displays complete hierarchical tree structure')
  })

  test('UI-7: Level chips display correctly', async ({ page }) => {
    // Navigate
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    // Create field and open modal
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/target field name/i).fill('TestField')
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()

    // Open parent dropdown
    await page.getByLabel(/parent node/i).click()

    // Verify level chips are visible
    const rootOption = page.getByRole('option', { name: /none.*root level/i })
    await expect(rootOption).toBeVisible()
    
    // Check if L0 chip is present in root option
    await expect(rootOption.locator('text=L0')).toBeVisible()

    console.log('✓ Level chips (L0, L1, L2, etc.) display correctly')
  })

  test('UI-8: Status box provides feedback', async ({ page }) => {
    // Navigate
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    // Create root field first
    let addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()
    await page.getByLabel(/target field name/i).fill('RootNode')
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()
    await page.getByLabel(/source field name/i).fill('root')
    await page.getByRole('button', { name: /^add field$/i }).click()
    await page.waitForTimeout(300)

    // Open modal again
    addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()

    // Initially should show info message
    await expect(page.getByText(/select a parent node/i)).toBeVisible()

    // Select parent
    await page.getByLabel(/parent node/i).click()
    await page.getByRole('option', { name: /rootnode/i }).click()

    // Status should update to success message
    await expect(page.getByText(/field will be nested under.*rootnode/i)).toBeVisible()

    console.log('✓ Status box provides appropriate feedback')
  })

  test('UI-9: Cancel button closes modal without saving', async ({ page }) => {
    // Navigate
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    // Fill in some data
    await page.getByLabel(/target field name/i).fill('TestField')
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()

    // Click Cancel
    await page.getByRole('button', { name: /cancel/i }).click()

    // Verify modal closes
    await expect(page.getByRole('dialog')).not.toBeVisible()

    // Verify no success message
    await expect(page.getByText(/added field.*testfield/i)).not.toBeVisible()

    console.log('✓ Cancel button works correctly')
  })

  test('UI-10: Nesting level input is editable', async ({ page }) => {
    // Navigate
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }

    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()

    // Find nesting level input
    const nestingLevelInput = page.getByLabel(/nesting level/i)
    await expect(nestingLevelInput).toBeVisible()

    // Clear and enter custom value
    await nestingLevelInput.clear()
    await nestingLevelInput.fill('3')

    // Verify value is set
    expect(await nestingLevelInput.inputValue()).toBe('3')

    console.log('✓ Nesting level input is editable')
  })
})
