import { test, expect, Page } from '@playwright/test'

test.describe('UI Tree Structure Builder - EnhancedAddFieldModal', () => {
  test.beforeEach(async ({ page }) => {
    // Navigate to the application (loads AdvancedTransform directly)
    await page.goto('http://localhost:3000')
    await page.waitForLoadState('domcontentloaded')
    await page.waitForTimeout(1000)

    // Setup: Select formats and upload file so FieldMappingInterface renders
    // Step 1: Select source format (JSON) from dropdown
    await page.getByLabel('Source Format').click()
    await page.getByRole('option', { name: /json/i }).click()
    await page.waitForTimeout(500)

    // Step 2: Select target format (XML) from dropdown
    await page.getByLabel('Target Format').click()
    await page.getByRole('option', { name: /xml/i }).click()
    await page.waitForTimeout(500)

    // Step 3: Upload a JSON file or use sample data
    // Use the "JSON Sample" button as it's easier than file upload for tests
    const jsonSampleButton = page.getByRole('button', { name: /json sample/i })
    await jsonSampleButton.click()
    await page.waitForTimeout(1500) // Wait for sample data to load and FieldMappingInterface to render
  })

  // Helper function to open the Add Field modal
  const openAddFieldModal = async (page: Page) => {
    const addFieldButton = page.getByRole('button', { name: /^add field$/i })
    await addFieldButton.waitFor({ state: 'visible', timeout: 15000 })
    await addFieldButton.click()
    await page.waitForTimeout(500)
  }

  test('UI-1: Modal opens and displays basic fields', async ({ page }) => {
    await openAddFieldModal(page)

    // Verify modal is open
    await expect(page.getByRole('dialog')).toBeVisible()
    await expect(page.getByText(/add new field/i)).toBeVisible()

    // Verify basic fields are present (exact label matches)
    await expect(page.getByLabel('Target Field Name')).toBeVisible()
    await expect(page.getByLabel('Field Type')).toBeVisible()
    
    console.log('✓ Modal opens successfully with basic fields')
  })

  test('UI-2: Tree Structure Builder appears for NESTED_OBJECT type', async ({ page }) => {
    await openAddFieldModal(page)

    // Initially, Tree Structure Builder should not be visible
    const treeBuilderText = page.getByText(/tree structure builder/i)
    await expect(treeBuilderText).not.toBeVisible()

    // Select Field Type dropdown
    await page.getByLabel(/field type/i).click()
    await page.waitForTimeout(300)
    
    // Select "Nested Object Field"
    await page.getByRole('option', { name: /nested object/i }).click()
    await page.waitForTimeout(300)

    // Now Tree Structure Builder should be visible
    await expect(treeBuilderText).toBeVisible()
    
    // Verify tree icon and parent node selector
    await expect(page.getByLabel(/parent node/i)).toBeVisible()

    console.log('✓ Tree Structure Builder appears for NESTED_OBJECT type')
  })

  test('UI-3: Create root level field (L1)', async ({ page }) => {
    await openAddFieldModal(page)

    // Fill in field details
    await page.getByLabel(/target field name/i).fill('Organization')
    
    // Select NESTED_OBJECT type
    await page.getByLabel(/field type/i).click()
    await page.waitForTimeout(300)
    await page.getByRole('option', { name: /nested object/i }).click()
    await page.waitForTimeout(300)

    // Fill source field
    await page.getByLabel(/source field name/i).fill('organization')

    // Click Add Field
    await page.getByRole('button', { name: /^add field$/i }).click()
    await page.waitForTimeout(500)

    // Verify modal closes
    await expect(page.getByRole('dialog')).not.toBeVisible()

    // Verify success message
    await expect(page.getByText(/added field.*organization/i)).toBeVisible({ timeout: 5000 })

    console.log('✓ Root level field (Organization L1) created successfully')
  })

  test('UI-4: Create nested field with parent selection', async ({ page }) => {
    // First, create root field "Organization"
    await openAddFieldModal(page)
    await page.getByLabel(/target field name/i).fill('Organization')
    await page.getByLabel(/field type/i).click()
    await page.waitForTimeout(300)
    await page.getByRole('option', { name: /nested object/i }).click()
    await page.waitForTimeout(300)
    await page.getByLabel(/source field name/i).fill('organization')
    await page.getByRole('button', { name: /^add field$/i }).click()
    await page.waitForTimeout(1000)

    // Now add child field "Departments"
    await openAddFieldModal(page)
    await page.getByLabel(/target field name/i).fill('Departments')
    await page.getByLabel(/field type/i).click()
    await page.waitForTimeout(300)
    await page.getByRole('option', { name: /nested object/i }).click()
    await page.waitForTimeout(500)

    // Open parent node dropdown
    await page.getByLabel(/parent node/i).click()
    await page.waitForTimeout(300)

    // Select "Organization"
    const organizationOption = page.getByRole('option', { name: /organization/i })
    await expect(organizationOption).toBeVisible()
    await organizationOption.click()
    await page.waitForTimeout(300)

    // Verify status message
    await expect(page.getByText(/field will be nested under/i)).toBeVisible()

    // Fill source field
    await page.getByLabel(/source field name/i).fill('departments')

    // Add field
    await page.getByRole('button', { name: /^add field$/i }).click()
    await page.waitForTimeout(500)

    // Verify success
    await expect(page.getByText(/added field.*departments/i)).toBeVisible({ timeout: 5000 })

    console.log('✓ Nested field with parent selection created successfully')
  })

  test('UI-5: Cancel button closes modal without saving', async ({ page }) => {
    await openAddFieldModal(page)

    // Fill in some data
    await page.getByLabel(/target field name/i).fill('TestField')
    await page.getByLabel(/field type/i).click()
    await page.waitForTimeout(300)
    await page.getByRole('option', { name: /nested object/i }).click()
    await page.waitForTimeout(300)

    // Click Cancel
    await page.getByRole('button', { name: /cancel/i }).click()
    await page.waitForTimeout(300)

    // Verify modal closes
    await expect(page.getByRole('dialog')).not.toBeVisible()

    // Verify no success message
    await expect(page.getByText(/added field.*testfield/i)).not.toBeVisible()

    console.log('✓ Cancel button works correctly')
  })
})
