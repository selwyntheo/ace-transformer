import { test, expect } from '@playwright/test'

test.describe('UI EnhancedAddFieldModal - All Field Types', () => {
  test.beforeEach(async ({ page }) => {
    await page.goto('http://localhost:3000')
    await page.waitForLoadState('networkidle')
    
    // Navigate to Quick Transform
    const quickTransformButton = page.getByRole('button', { name: /quick transform/i })
    if (await quickTransformButton.isVisible()) {
      await quickTransformButton.click()
    }
  })

  test('UI-FT-1: Create SIMPLE field', async ({ page }) => {
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    // Fill field details
    await page.getByLabel(/target field name/i).fill('userName')
    
    // Field type should be SIMPLE by default
    await expect(page.getByLabel(/field type/i)).toHaveValue('SIMPLE')
    
    // Fill source field
    await page.getByLabel(/source field name/i).fill('user.name')

    // Add field
    await page.getByRole('button', { name: /^add field$/i }).click()

    // Verify success
    await expect(page.getByText(/added field.*userName/i)).toBeVisible()

    console.log('✓ SIMPLE field created successfully')
  })

  test('UI-FT-2: Create COMPUTED field with UUID', async ({ page }) => {
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/target field name/i).fill('userId')
    
    // Select COMPUTED type
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /computed field/i }).click()

    // Verify computed type dropdown appears
    await expect(page.getByLabel(/computed type/i)).toBeVisible()
    
    // Select UUID
    await page.getByLabel(/computed type/i).click()
    await page.getByRole('option', { name: /UUID/i }).first().click()

    // Add field
    await page.getByRole('button', { name: /^add field$/i }).click()

    await expect(page.getByText(/added field.*userId/i)).toBeVisible()

    console.log('✓ COMPUTED field with UUID created successfully')
  })

  test('UI-FT-3: Create COMPUTED field with all types', async ({ page }) => {
    const computedTypes = [
      'UUID',
      'TIMESTAMP',
      'TIMESTAMP_ISO',
      'DATE',
      'COUNT',
      'INCREMENT',
      'CONSTANT',
      'RANDOM_STRING',
      'RANDOM_NUMBER'
    ]

    for (const computedType of computedTypes) {
      const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
      await addFieldButton.click()

      await page.getByLabel(/target field name/i).fill(`field_${computedType}`)
      await page.getByLabel(/field type/i).click()
      await page.getByRole('option', { name: /computed field/i }).click()

      // Select computed type
      await page.getByLabel(/computed type/i).click()
      await page.getByRole('option', { name: new RegExp(computedType, 'i') }).first().click()

      // For CONSTANT, fill transformation rule
      if (computedType === 'CONSTANT') {
        const transformationRule = page.getByLabel(/transformation rule/i)
        if (await transformationRule.isVisible()) {
          await transformationRule.fill('DEFAULT_VALUE')
        }
      }

      // For COUNT, fill source field
      if (computedType === 'COUNT') {
        await page.getByLabel(/source field name/i).fill('items')
      }

      await page.getByRole('button', { name: /^add field$/i }).click()
      await page.waitForTimeout(300)
    }

    console.log(`✓ All ${computedTypes.length} COMPUTED field types created successfully`)
  })

  test('UI-FT-4: Create KEY_VALUE_PAIR field', async ({ page }) => {
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/target field name/i).fill('metadata')
    
    // Select KEY_VALUE_PAIR type
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /key.*value.*pair/i }).click()

    // Verify key/value field name inputs appear
    await expect(page.getByLabel(/key field name/i)).toBeVisible()
    await expect(page.getByLabel(/value field name/i)).toBeVisible()

    // Fill source field
    await page.getByLabel(/source field name/i).fill('metadata')

    // Optional: customize key/value names
    await page.getByLabel(/key field name/i).clear()
    await page.getByLabel(/key field name/i).fill('name')
    await page.getByLabel(/value field name/i).clear()
    await page.getByLabel(/value field name/i).fill('value')

    await page.getByRole('button', { name: /^add field$/i }).click()

    await expect(page.getByText(/added field.*metadata/i)).toBeVisible()

    console.log('✓ KEY_VALUE_PAIR field created successfully')
  })

  test('UI-FT-5: Create NESTED_OBJECT with children', async ({ page }) => {
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/target field name/i).fill('userProfile')
    
    // Select NESTED_OBJECT type
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()

    await page.getByLabel(/source field name/i).fill('profile')

    // Add child fields - look for accordion or child section
    const addChildButton = page.getByRole('button', { name: /add child/i }).first()
    if (await addChildButton.isVisible()) {
      // Expand children section if collapsed
      const childrenAccordion = page.locator('text=Child Fields')
      if (await childrenAccordion.isVisible()) {
        await childrenAccordion.click()
      }

      // Add first child
      await addChildButton.click()
      const childFieldName = page.getByLabel(/child field name/i)
      if (await childFieldName.isVisible()) {
        await childFieldName.fill('firstName')
        const childSourceField = page.getByLabel(/child source field/i)
        await childSourceField.fill('first_name')
        
        // Confirm add child
        const confirmChildButton = page.getByRole('button', { name: /add.*child/i }).last()
        await confirmChildButton.click()
      }
    }

    await page.getByRole('button', { name: /^add field$/i }).click()

    await expect(page.getByText(/added field.*userProfile/i)).toBeVisible()

    console.log('✓ NESTED_OBJECT field with children created successfully')
  })

  test('UI-FT-6: Validation - Empty field name shows error', async ({ page }) => {
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    // Try to add without filling field name
    await page.getByRole('button', { name: /^add field$/i }).click()

    // Modal should still be open (validation failed)
    await expect(page.getByRole('dialog')).toBeVisible()

    console.log('✓ Validation prevents empty field name')
  })

  test('UI-FT-7: Field type switching updates UI correctly', async ({ page }) => {
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    // Start with SIMPLE
    await expect(page.getByLabel(/field type/i)).toHaveValue('SIMPLE')
    await expect(page.getByLabel(/computed type/i)).not.toBeVisible()

    // Switch to COMPUTED
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /computed field/i }).click()
    await expect(page.getByLabel(/computed type/i)).toBeVisible()

    // Switch to KEY_VALUE_PAIR
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /key.*value.*pair/i }).click()
    await expect(page.getByLabel(/key field name/i)).toBeVisible()

    // Switch to NESTED_OBJECT
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /nested object/i }).click()
    await expect(page.getByText(/tree structure builder/i)).toBeVisible()

    console.log('✓ Field type switching updates UI correctly')
  })

  test('UI-FT-8: Multiple fields can be added sequentially', async ({ page }) => {
    const fieldsToAdd = [
      { name: 'field1', type: 'SIMPLE', source: 'f1' },
      { name: 'field2', type: 'COMPUTED', source: 'f2' },
      { name: 'field3', type: 'SIMPLE', source: 'f3' }
    ]

    for (const field of fieldsToAdd) {
      const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
      await addFieldButton.click()

      await page.getByLabel(/target field name/i).fill(field.name)
      
      if (field.type === 'COMPUTED') {
        await page.getByLabel(/field type/i).click()
        await page.getByRole('option', { name: /computed field/i }).click()
        await page.getByLabel(/computed type/i).click()
        await page.getByRole('option', { name: /UUID/i }).first().click()
      }
      
      if (field.type === 'SIMPLE') {
        await page.getByLabel(/source field name/i).fill(field.source)
      }

      await page.getByRole('button', { name: /^add field$/i }).click()
      await page.waitForTimeout(300)
    }

    // Verify last field was added
    await expect(page.getByText(/added field.*field3/i)).toBeVisible()

    console.log('✓ Multiple fields added sequentially')
  })

  test('UI-FT-9: Modal resets form when closed and reopened', async ({ page }) => {
    // Open modal
    let addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    // Fill some data
    await page.getByLabel(/target field name/i).fill('TestField')
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /computed field/i }).click()

    // Close modal
    await page.getByRole('button', { name: /cancel/i }).click()

    // Reopen modal
    addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    // Verify form is reset
    expect(await page.getByLabel(/target field name/i).inputValue()).toBe('')
    expect(await page.getByLabel(/field type/i).inputValue()).toBe('SIMPLE')

    console.log('✓ Modal form resets correctly')
  })

  test('UI-FT-10: Transformation rule input for computed types', async ({ page }) => {
    const addFieldButton = page.getByRole('button', { name: /add target field/i }).first()
    await addFieldButton.click()

    await page.getByLabel(/target field name/i).fill('constantField')
    await page.getByLabel(/field type/i).click()
    await page.getByRole('option', { name: /computed field/i }).click()

    // Select CONSTANT type
    await page.getByLabel(/computed type/i).click()
    await page.getByRole('option', { name: /constant/i }).first().click()

    // Verify transformation rule input appears
    const transformationRule = page.getByLabel(/transformation rule/i)
    await expect(transformationRule).toBeVisible()

    // Fill transformation rule
    await transformationRule.fill('DEFAULT_CONSTANT_VALUE')

    await page.getByRole('button', { name: /^add field$/i }).click()

    await expect(page.getByText(/added field.*constantField/i)).toBeVisible()

    console.log('✓ Transformation rule input works for CONSTANT type')
  })
})
